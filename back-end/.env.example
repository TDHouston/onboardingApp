# Railway MySQL Database Variables
MYSQLHOST=your-railway-mysql-host
MYSQLPORT=3306
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=your-railway-mysql-password

# Alternative: Use DATABASE_URL if provided by Railway
# DATABASE_URL=mysql://user:password@host:port/database

# Server Port (Railway provides this)
PORT=8080

# Frontend URL for CORS
FRONTEND_URL=https://onboarding-app-ashy.vercel.app
CORS_ORIGINS=http://localhost:3000,https://onboarding-app-ashy.vercel.app